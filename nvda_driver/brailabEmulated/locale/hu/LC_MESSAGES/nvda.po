#. Translators: the synthesizer's name in NVDA's list of synthesizers.
#: synthDrivers/brailabEmulated.py
msgid "Brailab PC (emulated, PCF8200)"
msgstr "Brailab PC (emulált, PCF8200)"

#. The same, in the test build (build.py --test), which installs beside the released add-on.
#: build.py
msgid "Brailab PC (emulated, C test)"
msgstr "Brailab PC (emulált, C teszt)"

#. Translators: a checkbox in NVDA's voice settings. "Furcsa" is the BraiLab's own name
#. for its second, strange-sounding voice.
#: synthDrivers/brailabEmulated.py
msgid "&Furcsa (weird voice)"
msgstr "&Furcsa hang"

#. Translators: a checkbox in NVDA's voice settings; unchecked, the voice speaks in a monotone.
#: synthDrivers/brailabEmulated.py
msgid "&Use intonation"
msgstr "Hanglejtés &használata"
